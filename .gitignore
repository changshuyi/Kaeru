node_modules
dist
.DS_Store
*.local

# Capacitor native projects: commit the project itself, ignore build output
# and machine-specific files.
android/local.properties
android/.gradle
android/.kotlin
android/app/build
android/build
android/captures
android/.idea
*.iml

ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/App/*.xcuserstate
ios/App/**/xcuserdata

# generated by @capacitor/assets when re-running icon/splash generation
.capacitor-assets-cache
builds/
.claude/

# 測試產出（Playwright 執行結果/報表，每次跑都會重新生成）
test-results/
playwright-report/

# Android 正式簽署憑證跟密碼——絕對不能進版控。keystore 檔案本身要
# 另外備份到這台電腦以外的地方，遺失了無法重新產生一個「一樣」的。
android/keystore.properties
android/*.keystore
android/*.jks
